{
  "name": "nestjs-cloudflare",
  "version": "0.4.5",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable-objects": {
      "types": "./dist/durable-objects/index.d.ts",
      "import": "./dist/durable-objects/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule/index.d.ts",
      "import": "./dist/schedule/index.js"
    },
    "./websockets": {
      "types": "./dist/websockets/index.d.ts",
      "import": "./dist/websockets/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc",
    "build:example": "tsc -p tsconfig.example.json",
    "test:types": "tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@eslint/js": "^9.39.0",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/microservices": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/testing": "12.4.2",
    "@nestjs/websockets": "12.4.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/eslint-plugin": "1.6.28",
    "@types/node": "26.6.6",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "prettier": "^3.9.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.0",
    "wrangler": "4.159.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockchainian/nestjs-cloudflare.git"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "@nestjs/schedule": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "@cloudflare/workers-types": "5.20261110.1"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    },
    "@nestjs/schedule": {
      "optional": true
    },
    "@nestjs/websockets": {
      "optional": true
    }
  },
  "description": "NestJS integrations for Cloudflare Workers, Queues, scheduled events, and Durable Objects.",
  "keywords": [
    "nestjs",
    "cloudflare",
    "workers",
    "queues",
    "durable-objects"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/blockchainian/nestjs-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/blockchainian/nestjs-cloudflare/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
