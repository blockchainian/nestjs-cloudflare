{
  "name": "nestjs-cloudflare-tests",
  "main": "./ws-worker.ts",
  "durable_objects": {
    "bindings": [
      { "name": "HEALTHY_NATIVE", "class_name": "HealthyNativeRoom" },
      { "name": "FRAGILE_NATIVE", "class_name": "FragileNativeRoom" },
      { "name": "HEALTHY_ACTIVE", "class_name": "HealthyActiveRoom" },
      { "name": "FRAGILE_ACTIVE", "class_name": "FragileActiveRoom" },
      { "name": "HEALTHY_HIBERNATING", "class_name": "HealthyHibernatingRoom" },
      { "name": "FRAGILE_HIBERNATING", "class_name": "FragileHibernatingRoom" },

      { "name": "ACTIVE_TRANSPORT", "class_name": "ActiveTransportRoom" },
      {
        "name": "HIBERNATING_TRANSPORT",
        "class_name": "HibernatingTransportRoom",
      },
      { "name": "MULTI_GATEWAY", "class_name": "MultiGatewayRoom" },
      { "name": "TRANSPORT", "class_name": "TransportRoom" },
      { "name": "NATIVE_SCOPE", "class_name": "NativeScopeRoom" },
      { "name": "HIBERNATING_SCOPE", "class_name": "HibernatingScopeRoom" },
      { "name": "ACTIVE_SCOPE", "class_name": "ActiveScopeRoom" },
      { "name": "UPSTREAM", "class_name": "UpstreamRoom" },
      { "name": "ROOM", "class_name": "SocketRoom" },
      { "name": "PARSER_ROOM", "class_name": "ParserRoom" },
      { "name": "GATEWAY_ROOM", "class_name": "GatewayRoom" },
      { "name": "SECOND_GATEWAY_ROOM", "class_name": "GatewayRoom" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HealthyNativeRoom",
        "FragileNativeRoom",
        "HealthyActiveRoom",
        "FragileActiveRoom",
        "HealthyHibernatingRoom",
        "FragileHibernatingRoom",

        "ActiveTransportRoom",
        "HibernatingTransportRoom",
        "MultiGatewayRoom",
        "TransportRoom",
        "SocketRoom",
        "ParserRoom",
        "GatewayRoom",
        "NativeScopeRoom",
        "HibernatingScopeRoom",
        "ActiveScopeRoom",
        "UpstreamRoom",
      ],
    },
  ],
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "STATE", "id": "test-state" }],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "test-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "queues": { "producers": [{ "binding": "OUTBOX", "queue": "outbox" }] },
}
